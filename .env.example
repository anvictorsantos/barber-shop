# Database (Neon or Render Postgres)
DATABASE_URL=postgresql://user:password@host:5432/barbearia?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/barbearia?sslmode=require

# App
APP_URL=http://localhost:3000
SHOP_TIMEZONE=America/Sao_Paulo
SESSION_SECRET=
CRON_SECRET=
DEMO_MODE=false

# Google Tag Manager
# GTM loads only after the visitor accepts the consent banner.
# The GA4 tag inside the container must use send_page_view=false; the app pushes page_view.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_ANALYTICS_DEBUG=

# Sentry — client
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DEBUG=false
NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_IGNORE_ERRORS=ResizeObserver loop limit exceeded,Non-Error promise rejection captured

# Sentry — server and source maps
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_RELEASE=
SENTRY_DEBUG=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_IGNORE_ERRORS=ResizeObserver loop limit exceeded,Non-Error promise rejection captured
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Barbearia do Luiz <no-reply@barbeariadoluiz.com.br>"
EMAIL_REPLY_TO=
EMAIL_ENABLED=true

# WhatsApp Cloud API
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_CONFIRMATION=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_CANCELED=
WHATSAPP_TEMPLATE_RESCHEDULED=
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_NO_SHOW_BLOCK=
WHATSAPP_GRAPH_VERSION=v22.0

# Mercado Pago
MERCADO_PAGO_ENABLED=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
